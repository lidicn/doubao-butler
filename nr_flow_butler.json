[
  {
    "id": "tab_butler",
    "type": "tab",
    "label": "豆包管家转发",
    "disabled": false,
    "info": "豆包管家（doubao-butler）与 Node-RED 的桥接分支：\n1) 小爱语音「耳朵」：把小爱识别到的文本转发给管家（butler/event/voice）\n2) Bark 手机通知：管家每次开口时推送一条手机通知\n3)（可选，默认关）小爱「嘴巴」：管家开口时让小爱音箱也念出来\n\n导入后请按需修改：MQTT 凭据、小爱 ASR 主题/HA 实体、Bark 设备 key、HA token。",
    "env": []
  },
  {
    "id": "broker_butler",
    "type": "mqtt-broker",
    "name": "butler-mqtt",
    "broker": "192.168.2.200",
    "port": "1883",
    "clientid": "nr-butler-bridge",
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "birthTopic": "",
    "birthQos": "0",
    "birthPayload": "",
    "willTopic": "",
    "willQos": "0",
    "willPayload": "",
    "username": "butler",
    "password": "<REDACTED-MQTT口令 len=24>",
    "reconnectPeriod": "1000",
    "topicSelection": "all"
  },
  {
    "id": "ha_butler",
    "type": "server",
    "name": "home-assistant",
    "version": 0,
    "addon": false,
    "rejectUnauthorizedCerts": true,
    "url": "http://192.168.2.200:8123",
    "socketTimeout": "10",
    "token": "__FILL_HA_TOKEN__"
  },

  {
    "id": "in_asr",
    "type": "mqtt in",
    "z": "tab_butler",
    "name": "小爱 ASR",
    "topic": "xiaomi/asr",
    "qos": "1",
    "datatype": "auto",
    "broker": "broker_butler",
    "x": 150,
    "y": 80,
    "wires": [["fn_voice"]]
  },
  {
    "id": "fn_voice",
    "type": "function",
    "z": "tab_butler",
    "name": "组装 voice 事件",
    "func": "const m = (msg.payload && typeof msg.payload === 'object') ? msg.payload : {};\nconst text = (m.text || (typeof msg.payload === 'string' ? msg.payload : '')).toString().trim();\nif (!text) return null;\nconst member = m.member || '';\nmsg.topic = 'butler/event/voice';\nmsg.payload = { member, text };\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 380,
    "y": 80,
    "wires": [["out_voice"]]
  },
  {
    "id": "out_voice",
    "type": "mqtt out",
    "z": "tab_butler",
    "name": "→ butler/event/voice",
    "topic": "butler/event/voice",
    "qos": "1",
    "retain": false,
    "broker": "broker_butler",
    "x": 620,
    "y": 80,
    "wires": []
  },

  {
    "id": "in_speak",
    "type": "mqtt in",
    "z": "tab_butler",
    "name": "butler/speak/out",
    "topic": "butler/speak/out",
    "qos": "1",
    "datatype": "json",
    "broker": "broker_butler",
    "x": 150,
    "y": 200,
    "wires": [["fn_bark"]]
  },
  {
    "id": "fn_bark",
    "type": "function",
    "z": "tab_butler",
    "name": "组装 Bark 推送",
    "func": "const p = msg.payload || {};\nconst text = (p.text || '').toString();\nif (!text) return null;\nmsg.payload = { title: '豆包管家' + (p.member ? ' · ' + p.member : ''), body: text, level: 'active' };\nmsg.headers = { 'Content-Type': 'application/json' };\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 380,
    "y": 200,
    "wires": [["http_bark"]]
  },
  {
    "id": "http_bark",
    "type": "http request",
    "z": "tab_butler",
    "name": "Bark 推送",
    "method": "POST",
    "ret": "txt",
    "url": "http://192.168.2.200:18273/__FILL_BARK_KEY__/push",
    "tls": "",
    "x": 620,
    "y": 200,
    "wires": [[]]
  },

  {
    "id": "fn_xiaomi",
    "type": "function",
    "z": "tab_butler",
    "name": "组装 小爱 tts",
    "func": "const p = msg.payload || {};\nconst text = (p.text || '').toString();\nif (!text) return null;\nmsg.payload = {};\nmsg.data = { entity_id: 'tts.xiaomi_speaker', message: text };\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 380,
    "y": 300,
    "wires": [["ha_speak"]]
  },
  {
    "id": "ha_speak",
    "type": "api-call-service",
    "z": "tab_butler",
    "name": "小爱 tts.speak（默认关）",
    "server": "ha_butler",
    "version": 5,
    "domain": "tts",
    "service": "speak",
    "entityId": "tts.xiaomi_speaker",
    "data": "{\"entity_id\":\"tts.xiaomi_speaker\",\"message\":\"{{payload.text}}\"}",
    "dataType": "json",
    "mergecontext": "",
    "mustacheAltTags": false,
    "outputProperties": [],
    "queue": "none",
    "disabled": true,
    "x": 620,
    "y": 300,
    "wires": [[]]
  }
]
