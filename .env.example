# ===== 豆包管家 配置样例 =====
# 复制为 .env 后填入真实值；多数项有默认值（指向 192.168.2.x 家庭内网），未填则用默认。
# 例外·启动硬门槛（无默认值，缺键或空值则 get_settings() 当场 RuntimeError）：
#   DOUBAO_API_KEY / DESKPILOT_API_TOKEN / TASK_REPORT_TOKEN / BUTLER_WEB_PASSWORD
#   检查发生在第一次取配置处，报错位置离本文件隔两个模块，新部署请先补齐这四枚。
# 口径（批184）：`KEY=` 留空＝「没配」⇒ 用代码默认值（`_env` 与 `_env_int`/`_env_bool`/
#   `_env_file_defaults` 同口径，空值不再能把默认值顶掉）；要显式关掉某条腿请写 false/0。

# --- Web 服务 ---
BUTLER_HOST=0.0.0.0
BUTLER_PORT=8095
BUTLER_BASE_URL=http://192.168.2.200:8095
# WebUI 登录：BUTLER_WEB_USER 留空＝关口令登录（仅内网）；BUTLER_WEB_PASSWORD 留空＝启动硬门槛直接拒启，两枚不是一回事
BUTLER_WEB_USER=admin
BUTLER_WEB_PASSWORD=change_me_before_deploy
# 整站免鉴权开关：true＝同网段任何人不必登录即可操作管家（含发令），仅临时调试
BUTLER_ALLOW_NO_AUTH=false

# --- MQTT 事件总线（现有 mosquitto）---
MQTT_HOST=192.168.2.200
MQTT_PORT=1883
MQTT_USER=butler
MQTT_PASSWORD=your_mqtt_password_here
MQTT_CLIENT_ID=butler-core

# --- TV 端（Arcface 人脸识别 + TTS）---
TV_HTTP_URL=http://192.168.2.238:8080
TV_MQTT_PREFIX=tv/livingroom
# TVPilot（节目单/在播状态）HTTP 根址
TVPILOT_HTTP_URL=http://192.168.2.200:8090

# --- LLM（doubao2api，OpenAI 兼容）---
DOUBAO_API_URL=http://192.168.2.200:9090/v1/chat/completions
DOUBAO_API_KEY=your_doubao_api_key_here
DOUBAO_MODEL=doubao-seed-1-6
# 兼容网关根址（供拼 /v1 的调用方用；与上面那条完整 URL 是两枚键）
DOUBAO_BASE_URL=http://192.168.2.200:9090
# 上游失败重试：次数与退避底数（秒，可为小数）
LLM_RETRY_MAX=3
LLM_RETRY_BACKOFF=2.0
# 网页钩子：留令牌则校验后放行；allow_unauthenticated=true＝整条钩子不鉴权，仅内网调试
DOUBAO_WEBHOOK_TOKEN=
DOUBAO_WEBHOOK_ALLOW_UNAUTHENTICATED=false

# --- new-api 网关（OpenAI 兼容入口，与上面的 doubao 是两条上游）---
NEW_API_URL=http://192.168.2.200:3001/v1
NEW_API_KEY=
NEW_API_MODEL=deepseek-chat

# --- DeskPilot 联动（后两枚是启动硬门槛，值向 DeskPilot 侧取，⛔ 把真值提交进仓库）---
DESKPILOT_HTTP_URL=http://192.168.2.201:8765
DESKPILOT_API_TOKEN=
TASK_REPORT_TOKEN=
# 任务回报写入的 API 根址（默认指向管家自己）
TASK_API_BASE_URL=http://192.168.2.200:8095

# --- memory-agent（语义记忆 + VLM 场景）---
MEMORY_AGENT_URL=http://192.168.2.200:8086
MEMORY_AGENT_MCP_URL=http://192.168.2.200:8086/mcp
MEMORY_AGENT_TOKEN=your_memory_agent_token_here
# 口令与双向令牌：值向 memory-agent 侧取，⛔ 把真值提交进仓库
MEMORY_AGENT_USER=
MEMORY_AGENT_PASS=
MEMORY_AGENT_BUTLER_TOKEN=
MEMORY_AGENT_APP_TOKEN=

# --- Home Assistant（小爱音箱 tts.speak / 传感器）---
HA_URL=http://192.168.2.200:8123
HA_TOKEN=
# 小爱/米家：三枚凭据值向米家侧取；播放类型与实体名非敏感
XIAOMI_SERVICE_TOKEN=
XIAOMI_USER_ID=
XIAOMI_SSECURITY=
XIAOMI_PLAY_TYPE=2
# 通知实体：默认值连着你这台小爱的账号 id，已写死在 butler/config.py 的默认里 ⇒ 留空即用默认
XIAOMI_NOTIFY_ENTITY=
# 唤醒播报另指的实体；留空＝沿用上面那台
XIAOMI_WAKE_ENTITY=

# --- 天气服务（内网 :3000，整段 URL 可换；默认值＝代码内置）---
WEATHER_API_URL=http://192.168.2.200:3000/api/weather

# --- 摄像头（go2rtc 拉流；账号口令为凭据，⛔ 落进仓库）---
GO2RTC_BASE_URL=http://192.168.2.200:1984
GO2RTC_USER=
GO2RTC_PASS=

# --- Bark 推送（兜底发声）---
BARK_URL=http://192.168.2.200:18273
# 自托管 Bark 服务端的设备 key（手机端 Bark App 注册后获得）；留空则推送会报 device key 空
BARK_KEY=
# 端到端加密（WO-DB-114）：两枚都留空＝不加密，推送走明文 URL；填了则 key/iv 必须成对
BARK_ENCRYPT_KEY=
BARK_ENCRYPT_IV=

# --- TTS 双引擎 ---
TTS_PRIMARY=edge-tts
TTS_EDGE_VOICE=zh-CN-XiaoxiaoNeural
TTS_KOKORO_URL=http://doubao-butler-kokoro:8880/v1/audio/speech
TTS_KOKORO_VOICE=zm_Yunzhe
TTS_SPEED=1.0
TTS_VOLUME=80
TTS_CACHE_ENABLED=true
# 第三引擎 nowvoice：令牌为凭据；voice 留空＝用 butler/config.py 里内置的那枚 voice id
NOWVOICE_TOKEN=
NOWVOICE_VOICE=
NOWVOICE_TIMEOUT_SEC=45
# 发声出口 tv／mqtt。⚠ docker-compose.yml 的 environment 段现注入 mqtt，
#   而 compose 的 environment 优先于 env_file ⇒ 改这一行不生效，要改 compose 那一行。
BUTLER_SPEAK_TARGET=tv

# --- 对话与唤醒 ---
LLM_TIMEOUT=15
COOLDOWN_SECONDS=600
ACTIVE_DIALOG_TIMEOUT=10
WAITING_SECONDS=5
DEDUP_WINDOW_DAYS=7
DEDUP_JACCARD_THRESHOLD=0.6
# 唤醒词（语音入口匹配）
WAKE_PHRASE=豆包管家
# 主动服务预算：每角色每日上限／负反馈后的地板／问询窗口（秒）
PROACTIVE_DAILY_LIMIT=3
PROACTIVE_REDUCE_FLOOR=1
PROACTIVE_INQUIRY_TIMEOUT_SEC=3600
# 负反馈词表（逗号分隔，留空＝用代码内置那份）与按角色上限（形如 butler=5,kevin=2）
PROACTIVE_NEGATIVE_WORDS=
PROACTIVE_ROLE_LIMITS=
# 主成员名：定位/睡眠/无活动三条判定读它（批178 P1-42），值要与 memory-agent 的成员名册一致
PRIMARY_MEMBER=lidicn

# --- 免打扰时段（本地时间 HH:MM，逗号分隔，可多段）---
DND_WINDOWS=
AUTOFORGE_INBOX_KEY=
XIAOMI_PASS_TOKEN=
AUTOFORGE_ANSWER_WINDOW_S=900

# --- AutoForge ask 桥：AF 地址与写权限令牌（WO-BUT-012、WO-BUT-020）---
# 留空＝沿用 butler/af_bridge.py 模块常量 _base_url；真值由 owner 填 .env，改 .env 需 up -d 才生效
AUTOFORGE_BASE_URL=
AUTOFORGE_API_TOKEN=

# --- 路径与容器运维（改这几枚要 `up -d` 重建才生效，restart 不重读 .env）---
DATA_DIR=/app/data
TTS_DIR=/app/tts
# new-api 库直连与 docker.sock 挂载路径（NAS 运维用，实际挂载见 docker-compose.yml volumes）
NEWAPI_DB_PATH=/app/data/new-api.db
DOCKER_SOCKET_PATH=/var/run/docker.sock

# --- WebUI 自更新（批197）：发布源与开关 ---
# 总开关：false＝三个端点只读不写、POST /api/system/update 一律 403
# 真正的 fetch/apply/restart 由宿主 cron 跑 scripts/host_check_update.sh + host_update.sh，容器只写请求件
SELF_UPDATE_ENABLED=false
UPDATE_REPO_URL=https://github.com/lidicn/doubao-butler.git
UPDATE_BRANCH=main
