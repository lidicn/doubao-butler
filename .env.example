# ===== 豆包管家 配置样例 =====
# 复制为 .env 后填入真实值；多数项有默认值（指向 192.168.2.x 家庭内网），未填则用默认。
# 例外·启动硬门槛（无默认值，缺键或空值则 get_settings() 当场 RuntimeError）：
#   DOUBAO_API_KEY / DESKPILOT_API_TOKEN / TASK_REPORT_TOKEN / BUTLER_WEB_PASSWORD
#   检查发生在第一次取配置处，报错位置离本文件隔两个模块，新部署请先补齐这四枚。

# --- Web 服务 ---
BUTLER_HOST=0.0.0.0
BUTLER_PORT=8095
BUTLER_BASE_URL=http://192.168.2.200:8095
# WebUI 登录（留空则关闭登录鉴权，仅内网使用）
BUTLER_WEB_USER=admin
BUTLER_WEB_PASSWORD=change_me_before_deploy

# --- MQTT 事件总线（现有 mosquitto）---
MQTT_HOST=192.168.2.200
MQTT_PORT=1883
MQTT_USER=butler
MQTT_PASSWORD=your_mqtt_password_here
MQTT_CLIENT_ID=butler-core

# --- TV 端（Arcface 人脸识别 + TTS）---
TV_HTTP_URL=http://192.168.2.238:8080
TV_MQTT_PREFIX=tv/livingroom

# --- LLM（doubao2api，OpenAI 兼容）---
DOUBAO_API_URL=http://192.168.2.200:9090/v1/chat/completions
DOUBAO_API_KEY=your_doubao_api_key_here
DOUBAO_MODEL=doubao-seed-1-6

# --- DeskPilot 联动（后两枚是启动硬门槛，值向 DeskPilot 侧取，⛔ 把真值提交进仓库）---
DESKPILOT_HTTP_URL=http://192.168.2.201:8765
DESKPILOT_API_TOKEN=
TASK_REPORT_TOKEN=

# --- memory-agent（语义记忆 + VLM 场景）---
MEMORY_AGENT_URL=http://192.168.2.200:8086
MEMORY_AGENT_MCP_URL=http://192.168.2.200:8086/mcp
MEMORY_AGENT_TOKEN=your_memory_agent_token_here

# --- Home Assistant（小爱音箱 tts.speak / 传感器）---
HA_URL=http://192.168.2.200:8123
HA_TOKEN=

# --- 天气服务（内网 :3000，整段 URL 可换；默认值＝代码内置）---
WEATHER_API_URL=http://192.168.2.200:3000/api/weather

# --- Bark 推送（兜底发声）---
BARK_URL=http://192.168.2.200:18273
# 自托管 Bark 服务端的设备 key（手机端 Bark App 注册后获得）；留空则推送会报 device key 空
BARK_KEY=

# --- TTS 双引擎 ---
TTS_PRIMARY=edge-tts
TTS_EDGE_VOICE=zh-CN-XiaoxiaoNeural
TTS_KOKORO_URL=http://doubao-butler-kokoro:8880/v1/audio/speech
TTS_KOKORO_VOICE=zm_Yunzhe
TTS_SPEED=1.0
TTS_VOLUME=80
TTS_CACHE_ENABLED=true

# --- 对话与唤醒 ---
LLM_TIMEOUT=15
COOLDOWN_SECONDS=600
ACTIVE_DIALOG_TIMEOUT=10
WAITING_SECONDS=5
DEDUP_WINDOW_DAYS=7
DEDUP_JACCARD_THRESHOLD=0.6

# --- 免打扰时段（本地时间 HH:MM，逗号分隔，可多段）---
DND_WINDOWS=
AUTOFORGE_INBOX_KEY=
XIAOMI_PASS_TOKEN=
AUTOFORGE_ANSWER_WINDOW_S=900

# --- AutoForge ask 桥：AF 地址与写权限令牌（WO-BUT-012、WO-BUT-020）---
# 留空＝沿用 butler/af_bridge.py 模块常量 _base_url；真值由 owner 填 .env，改 .env 需 up -d 才生效
AUTOFORGE_BASE_URL=
AUTOFORGE_API_TOKEN=
